print('=== EXPORTS STARTED - CHECK TASKS TAB ===');
// ============================================
// ADDITION 1 — Sentinel-1 SAR Data
// ============================================

var sar = ee.ImageCollection('COPERNICUS/S1_GRD')
  .filterBounds(mandya)
  .filterDate('2025-01-01', '2025-03-31')
  .filter(ee.Filter.eq('instrumentMode', 'IW'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VV'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))
  .select(['VV', 'VH'
])
  .mean()
  .clip(mandya);

// VH/VV Ratio — sensitive to crop structure
var sarRatio = sar.select('VH').divide(sar.select('VV')).rename('VH_VV_ratio');

// Visualize SAR
Map.addLayer(sar.select('VV'),
{min: -20, max: 0
}, 'SAR — VV Polarization');
Map.addLayer(sar.select('VH'),
{min: -25, max: -5
}, 'SAR — VH Polarization');
Map.addLayer(sarRatio,
{min: -1, max: 0, palette: ['brown','yellow','green'
    ]
}, 'SAR — VH/VV Ratio');

print('=== SAR LOADED ===');
print('VV: Sensitive to surface roughness & soil moisture');
print('VH: Sensitive to crop volume & canopy structure');

// ============================================
// ADDITION 2 — Soil Moisture Index (SMI)
// ============================================
// SMI from SAR VV — wetter soil = higher backscatter
var smi = sar.select('VV')
  .unitScale(-25,
-5)
  .rename('SMI');

Map.addLayer(smi,
{
  min: 0, max: 1,
  palette: ['red', 'orange', 'yellow', 'green', 'blue'
    ]
}, 'Soil Moisture Index (SMI)');

print('=== SMI LOADED ===');
print('SMI: 0=Dry  |  1=Wet');

// ============================================
// ADDITION 3 — GLCM Texture Features
// ============================================

var glcm = s2.select('B8')
  .toInt()
  .glcmTexture({size: 3
});

var contrast = glcm.select('B8_contrast').rename('Contrast');
var entropy  = glcm.select('B8_ent').rename('Entropy');
var homog    = glcm.select('B8_idm').rename('Homogeneity');

Map.addLayer(contrast,
{min: 0, max: 1000, palette: ['white','blue','navy'
    ]
}, 'GLCM Contrast');
Map.addLayer(entropy,
{min: 0, max: 3,    palette: ['white','green','darkgreen'
    ]
}, 'GLCM Entropy');

print('=== GLCM TEXTURE LOADED ===');
print('Contrast: Measures local variation');
print('Entropy: Measures disorder/complexity');

// ============================================
// ADDITION 4 — Retrain RF with ALL Features
// ============================================
// Build enhanced image with SAR + Texture
var imageEnhanced = s2.select(['B2','B3','B4','B8','B11','B12'
])
  .addBands(ndvi)
  .addBands(ndwi)
  .addBands(sar.select(['VV','VH'
]))
  .addBands(sarRatio)
  .addBands(smi)
  .addBands(contrast)
  .addBands(entropy);

var bandsEnhanced = [
  'B2','B3','B4','B8','B11','B12', // Spectral
  'NDVI','NDWI', // Optical indices
  'VV','VH','VH_VV_ratio', // SAR
  'SMI', // Soil moisture
  'Contrast','Entropy' // Texture
];

// ============================================
// ADDITION 5 — Proper Train/Test Split (70/30)
// ============================================

var cropsWithRandom = crops.randomColumn('random',
42); // seed=42 for reproducibility
var trainSet = cropsWithRandom.filter(ee.Filter.lt('random',
0.7));
var testSet  = cropsWithRandom.filter(ee.Filter.gte('random',
0.7));

print('=== TRAIN/TEST SPLIT ===');
print('Training set (70%):', trainSet.size());
print('Test set (30%):', testSet.size());

// Extract training samples
var trainSamples = imageEnhanced.select(bandsEnhanced).sampleRegions({
  collection: trainSet,
  properties: ['label', 'crop'
    ],
  scale: 10
});

// Extract test samples
var testSamples = imageEnhanced.select(bandsEnhanced).sampleRegions({
  collection: testSet,
  properties: ['label', 'crop'
    ],
  scale: 10
});

print('Training samples extracted:', trainSamples.size());
print('Test samples extracted:', testSamples.size());

// ============================================
// Train Enhanced Random Forest
// ============================================

var classifierEnhanced = ee.Classifier.smileRandomForest({
  numberOfTrees: 100,
  seed: 42
}).train({
  features: trainSamples,
  classProperty: 'label',
  inputProperties: bandsEnhanced
});

// ============================================
// Classify with enhanced model
// ============================================

var cropMapEnhanced = imageEnhanced.select(bandsEnhanced).classify(classifierEnhanced);

Map.addLayer(cropMapEnhanced,
{
  min: 0, max: 2,
  palette: ['yellow', 'green', 'brown'
    ]
}, 'Enhanced Crop Map (SAR + Optical)');

// ============================================
// PROPER Validation on TEST SET
// ============================================

var testValidated = testSamples.classify(classifierEnhanced);
var testMatrix    = testValidated.errorMatrix('label', 'classification');

print('=== ENHANCED MODEL — TEST SET ACCURACY ===');
print('Overall Accuracy (Test):', testMatrix.accuracy());
print('Kappa Coefficient (Test):', testMatrix.kappa());
print('Confusion Matrix (Test):', testMatrix);
print('Producers Accuracy:', testMatrix.producersAccuracy());
print('Consumers Accuracy:', testMatrix.consumersAccuracy());

// ============================================
// ADDITION 6 — SAR-based Stress Detection
// ============================================
// Low VH backscatter = low canopy volume = potential stress
var sarStress = sar.select('VH').lt(-18).rename('SAR_Stress');

// Combined stress: NDVI stress + SAR stress
var combinedStress = stress_t2.or(sarStress).rename('Combined_Stress');

Map.addLayer(sarStress,
{
  min: 0, max: 1,
  palette: ['green', 'red'
    ]
}, 'SAR-Based Stress');

Map.addLayer(combinedStress,
{
  min: 0, max: 1,
  palette: ['green', 'red'
    ]
}, 'Combined Stress (Optical + SAR)');

print('=== SAR STRESS DETECTION ===');
print('VH < -18 dB = Low canopy volume = Stress detected');

// ============================================
// Feature Importance (bonus insight)
// ============================================

var importance = ee.Dictionary(classifierEnhanced.explain().get('importance'));
print('=== FEATURE IMPORTANCE ===', importance);
// ============================================
// ADDITION 7 — Pest Risk Detection (Red-Edge + Climatic)
// ============================================
// 7a. Red-Edge index — more sensitive to early pest/disease stress than NDVI
var ndre = s2.normalizedDifference(['B8', 'B5'
]).rename('NDRE');
Map.addLayer(ndre,
{min: 0, max: 0.6, palette: ['red','yellow','green'
    ]
}, 'NDRE (Pest/Disease Sensitivity)');

// Early signature: canopy structure (NDVI) still fine, but chlorophyll (NDRE) dropping
var pestSignature = ndre.lt(0.25).and(ndvi.gt(0.4)).rename('Pest_Signature');
Map.addLayer(pestSignature,
{min: 0, max: 1, palette: ['green','orange'
    ]
}, 'Possible Pest/Disease Signature');

// 7b. Climatic Pest Risk — temp + humidity favorability (ERA5-Land)
var era5 = ee.ImageCollection('ECMWF/ERA5_LAND/DAILY_AGGR')
  .filterDate('2025-01-01', '2025-01-08')
  .filterBounds(mandya);

var temp = era5.select('temperature_2m').mean().subtract(273.15).rename('Temp_C').clip(mandya);
var dewpoint = era5.select('dewpoint_temperature_2m').mean().subtract(273.15).rename('Dewpoint_C').clip(mandya);

// Magnus formula approximation for relative humidity
var rh = dewpoint.multiply(17.625).divide(dewpoint.add(243.04)).exp()
  .divide(temp.multiply(17.625).divide(temp.add(243.04)).exp())
  .multiply(100).rename('RH_percent');

Map.addLayer(temp,
{min: 15, max: 40, palette: ['blue','yellow','red'
    ]
}, 'Temperature (°C)');
Map.addLayer(rh,
{min: 0, max: 100, palette: ['brown','yellow','blue'
    ]
}, 'Relative Humidity (%)');

// Most rice/sugarcane pests (brown planthopper, stem borer) favor 25-30°C + >80% RH
var pestRisk = temp.gte(25).and(temp.lte(30)).and(rh.gte(80)).rename('Pest_Risk_Climatic');
Map.addLayer(pestRisk,
{min: 0, max: 1, palette: ['white','red'
    ]
}, 'Climatic Pest Risk Zone');

var combinedPestRisk = pestSignature.or(pestRisk).rename('Combined_Pest_Risk');
Map.addLayer(combinedPestRisk,
{min: 0,max: 1, palette: ['green','red'
    ]
}, 'Combined Pest Risk Map');
// ============================================
// ADDITION 8 — Unpredictable Weather / Anomaly Detection
// ============================================

var currentRain = ee.ImageCollection('UCSB-CHG/CHIRPS/DAILY')
  .filterDate('2025-01-01', '2025-01-08').filterBounds(mandya).sum().clip(mandya);

var historicalRain = ee.ImageCollection('UCSB-CHG/CHIRPS/DAILY')
  .filterDate('2020-01-01', '2025-01-08')
  .filter(ee.Filter.calendarRange(1,
8, 'day_of_year'))
  .filterBounds(mandya).mean().clip(mandya);

var rainAnomaly = currentRain.subtract(historicalRain).rename('Rain_Anomaly_mm');
Map.addLayer(rainAnomaly,
{min: -30, max: 30, palette: ['red','white','blue'
    ]
}, 'Rainfall Anomaly (Red=Dry, Blue=Excess)');

var drySpellFlag = rainAnomaly.lt(-15).rename('Dry_Spell_Alert');
var excessRainFlag = rainAnomaly.gt(15).rename('Excess_Rain_Alert');
Map.addLayer(drySpellFlag,
{min: 0,max: 1,palette: ['white','orange'
    ]
}, 'Dry Spell Alert');
Map.addLayer(excessRainFlag,
{min: 0,max: 1,palette: ['white','blue'
    ]
}, 'Excess Rain Alert');

// Temperature volatility — day-to-day swing over the week
var tempDaily = era5.select('temperature_2m').map(function(img){
  return img.subtract(273.15).copyProperties(img,
    ['system:time_start'
    ]);
});
var tempStdDev = tempDaily.reduce(ee.Reducer.stdDev()).rename('Temp_Volatility').clip(mandya);
Map.addLayer(tempStdDev,
{min: 0, max: 5, palette: ['green','yellow','red'
    ]
}, 'Temperature Volatility');

print('=== WEATHER UNPREDICTABILITY ===');
print('Rain anomaly: current vs 5-year historical average for same window');
print('Temp volatility: higher week-to-week swing = less predictable conditions');
// ============================================
// ADDITION 9 — Unified Risk Advisory (Water + Pest + Weather)
// ============================================

var weatherAlert = drySpellFlag.or(excessRainFlag);

var unifiedRisk = irrigationAdvisory
  .add(combinedPestRisk.multiply(2))
  .add(weatherAlert.multiply(1))
  .rename('Unified_Risk_Score');

Map.addLayer(unifiedRisk,
{
  min: 0, max: 6,
  palette: ['blue','green','yellow','orange','red','darkred'
    ]
}, 'Unified Risk Score');

print('=== UNIFIED RISK ===');
print('0-1: Low | 2-3: Monitor | 4-5: Action needed | 6: Urgent multi-factor alert');
