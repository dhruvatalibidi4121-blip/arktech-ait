// Load Sentinel-2 image for Mandya
var s2 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(mandya)
  .filterDate('2025-01-01', '2025-03-31')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE',
20))
  .median()
  .clip(mandya);

// Calculate NDVI and NDWI
var ndvi = s2.normalizedDifference(['B8', 'B4'
]).rename('NDVI');
var ndwi = s2.normalizedDifference(['B3', 'B8'
]).rename('NDWI');

// Combine all bands + indices
var image = s2.select(['B2','B3','B4','B8','B11','B12'
])
              .addBands(ndvi)
              .addBands(ndwi);

// ============================================
// Extract training samples from ground truth
// ============================================
var bands = ['B2','B3','B4','B8','B11','B12','NDVI','NDWI'
];

var training = image.select(bands).sampleRegions({
  collection: crops,
  properties: ['label', 'crop'
    ],
  scale: 10
});

print('Training samples:', training.size());

// ============================================
// Train Random Forest Classifier
// ============================================
var classifier = ee.Classifier.smileRandomForest(100).train({
  features: training,
  classProperty: 'label',
  inputProperties: bands
});

// ============================================
// Classify the image
// ============================================
var cropMap = image.select(bands).classify(classifier);

// Visualize crop map
Map.addLayer(cropMap,
{
  min: 0, max: 2,
  palette: ['yellow', 'green', 'brown'
    ]
}, 'Crop Classification Map');

// ============================================
// Accuracy Assessment
// ============================================
var validated = training.classify(classifier);
var matrix = validated.errorMatrix('label', 'classification');

print('=== ACCURACY METRICS ===');
print('Overall Accuracy:', matrix.accuracy());
print('Kappa Coefficient:', matrix.kappa());
print('Confusion Matrix:', matrix);

// ============================================
// Legend info
// ============================================
print('Legend: Yellow=Sugarcane | Green=Rice | Brown=Fallow');
// ============================================
// PHASE 3 — Phenology / Growth Stage Mapping
// ============================================
// Stage 1: Sowing (Oct-Nov 2024)
var s2_t1 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(mandya)
  .filterDate('2024-10-01', '2024-11-30')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE',
20))
  .median().clip(mandya);

// Stage 2: Vegetative (Dec 2024 - Jan 2025)
var s2_t2 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(mandya)
  .filterDate('2024-12-01', '2025-01-31')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE',
20))
  .median().clip(mandya);

// Stage 3: Flowering/Maturity (Feb-Mar 2025)
var s2_t3 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(mandya)
  .filterDate('2025-02-01', '2025-03-31')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE',
20))
  .median().clip(mandya);

// NDVI for each stage
var ndvi_t1 = s2_t1.normalizedDifference(['B8','B4'
]).rename('NDVI_Sowing');
var ndvi_t2 = s2_t2.normalizedDifference(['B8','B4'
]).rename('NDVI_Vegetative');
var ndvi_t3 = s2_t3.normalizedDifference(['B8','B4'
]).rename('NDVI_Flowering');

// Stress thresholds per stage
// Sowing: NDVI < 0.2 = stress
// Vegetative: NDVI < 0.4 = stress
// Flowering: NDVI < 0.5 = stress
var stress_t1 = ndvi_t1.lt(0.2).rename('Stress_Sowing');
var stress_t2 = ndvi_t2.lt(0.4).rename('Stress_Vegetative');
var stress_t3 = ndvi_t3.lt(0.5).rename('Stress_Flowering');

// Visualize NDVI per stage
var ndviVis = {min: 0, max: 1, palette: ['red','yellow','green'
    ]
};

Map.addLayer(ndvi_t1, ndviVis, 'NDVI - Sowing Stage');
Map.addLayer(ndvi_t2, ndviVis, 'NDVI - Vegetative Stage');
Map.addLayer(ndvi_t3, ndviVis, 'NDVI - Flowering Stage');

// Visualize stress per stage
var stressVis = {min: 0, max: 1, palette: ['green','red'
    ]
};

Map.addLayer(stress_t1, stressVis, 'Stress - Sowing Stage');
Map.addLayer(stress_t2, stressVis, 'Stress - Vegetative Stage');
Map.addLayer(stress_t3, stressVis, 'Stress - Flowering Stage');

// VCI - Vegetation Condition Index
var ndvi_min = ndvi_t1.min(ndvi_t2).min(ndvi_t3);
var ndvi_max = ndvi_t1.max(ndvi_t2).max(ndvi_t3);
var vci = ndvi_t2.subtract(ndvi_min)
                 .divide(ndvi_max.subtract(ndvi_min))
                 .multiply(100)
                 .rename('VCI');

Map.addLayer(vci,
{min: 0, max: 100, 
  palette: ['red','orange','yellow','green'
    ]
}, 'VCI - Stress Index');

print('=== GROWTH STAGES LOADED ===');
print('Stage 1: Sowing (Oct-Nov 2024)');
print('Stage 2: Vegetative (Dec 2024 - Jan 2025)');
print('Stage 3: Flowering (Feb-Mar 2025)');
// ============================================
// PHASE 4 — Water Deficit & Irrigation Advisory
// ============================================
// CHIRPS Rainfall data (8-day window)
var rainfall = ee.ImageCollection('UCSB-CHG/CHIRPS/DAILY')
  .filterDate('2025-01-01', '2025-01-08')
  .filterBounds(mandya)
  .sum()
  .clip(mandya);

Map.addLayer(rainfall,
{
  min: 0, max: 50,
  palette: ['white','lightblue','blue'
    ]
}, 'Rainfall (8-day mm)');

// ============================================
// Crop Water Requirement (ETc)
// Sugarcane = 6mm/day → 48mm per 8 days
// Rice = 7mm/day → 56mm per 8 days
// Fallow = 1mm/day → 8mm per 8 days
// ============================================
// ETc map based on crop classification
var ETc = cropMap
  .where(cropMap.eq(0),
48) // Sugarcane
  .where(cropMap.eq(1),
56) // Rice
  .where(cropMap.eq(2),
8) // Fallow
  .rename('ETc_mm');

// Water Deficit = ETc - Rainfall
var waterDeficit = ETc.subtract(rainfall).rename('Water_Deficit');

// Clamp negatives to 0 (no deficit if rainfall exceeds need)
waterDeficit = waterDeficit.max(0);

Map.addLayer(waterDeficit,
{
  min: 0, max: 56,
  palette: ['blue','yellow','orange','red'
    ]
}, 'Water Deficit Map (mm)');

// ============================================
// Irrigation Advisory Classification
// ============================================
// 0-10mm deficit  → No irrigation needed
// 10-25mm deficit → Light irrigation
// 25-40mm deficit → Moderate irrigation
// 40+ mm deficit  → Urgent irrigation

var irrigationAdvisory = waterDeficit
  .where(waterDeficit.lte(10),
0) // No irrigation
  .where(waterDeficit.gt(10).and(waterDeficit.lte(25)),
1) // Light
  .where(waterDeficit.gt(25).and(waterDeficit.lte(40)),
2) // Moderate
  .where(waterDeficit.gt(40),
3) // Urgent
  .rename('Irrigation_Advisory');

Map.addLayer(irrigationAdvisory,
{
  min: 0, max: 3,
  palette: ['blue','green','orange','red'
    ]
}, 'Irrigation Advisory Map');

// ============================================
// Print summary stats
// ============================================
var deficitStats = waterDeficit.reduceRegion({
  reducer: ee.Reducer.mean().combine(
    ee.Reducer.min(),
    null, true).combine(
    ee.Reducer.max(),
    null, true),
  geometry: mandya,
  scale: 1000,
  maxPixels: 1e9
});

print('=== IRRIGATION ADVISORY ===');
print('Blue  = No Irrigation Needed');
print('Green = Light Irrigation');
print('Orange = Moderate Irrigation');
print('Red   = Urgent Irrigation');
print('Water Deficit Stats (mm):', deficitStats);
